# this is a language file, any language specific data should go here
{
  "id"          : "ui2",
  "description" : "Experimental modern GenApp UI target",
  "version"     : 1,
  "assembly"    : [
                   {
                    "frequency"  : "once",
                    "output"     : "index.html",
                    "inputs"     : [
                                    { "index.html" : "once" }
                                  ]
                   }
                  ,{
                    "frequency"  : "once",
                    "output"     : "js/app-map.js",
                    "inputs"     : [
                                    { "app-map.header.js" : "once" },
                                    { "app-map.menu.js"   : "menu:id" },
                                    { "app-map.module.js" : "menu:modules:id" },
                                    { "app-map.footer.js" : "once" }
                                  ]
                   }
                  ,{
                    "frequency"  : "once",
                    "output"     : "ajax/ui2_session_handoff.php",
                    "inputs"     : [
                                    { "ui2_session_handoff.php" : "once" }
                                  ]
                   }
                  ,{
                    "frequency"  : "menu:modules:id",
                    "output"     : "modules/__menu:modules:id__.json",
                    "inputs"     : [
                                    { "module-summary.json" : "once" }
                                   ]
                   }
                  ,{
                    "frequency"  : "config:modules:id",
                    "output"     : "modules/__modules:id__.json",
                    "clobber"    : "true",
                    "inputs"     : [
                                    { "module-summary.config.json" : "once" }
                                   ]
                   }
                  ,{
                    "frequency"  : "configbase:modules:id",
                    "output"     : "modules/__modules:id__.json",
                    "clobber"    : "true",
                    "inputs"     : [
                                    { "module-summary.configbase.json" : "once" }
                                   ]
                   }
                  ]
}
