{
    "description": "PHP libraries for the html5 language. 'composer install' in this directory writes them to add/vendor, which genapp copies into every application. The platform section is the runtime they are resolved for: the oldest supported PHP (8.1) and the mongodb and zmq extensions of dockerfiles/genappalpha_php8.",
    "require": {
        "php": ">=8.1",
        "alcaeus/mongo-php-adapter": "^1.2.5",
        "mongodb/mongodb": "^1.21.5",
        "cboden/ratchet": "^0.4.4",
        "react/event-loop": "^1.5",
        "react/socket": "^1.16",
        "react/zmq": "^0.4",
        "google/apiclient": "^2.18",
        "rmccue/requests": "^2.0"
    },
    "config": {
        "vendor-dir": "add/vendor",
        "platform": {
            "php": "8.1.2",
            "ext-mongodb": "1.21.12",
            "ext-zmq": "1.1.3"
        },
        "platform-check": false,
        "sort-packages": true
    },
    "extra": {
        "google/apiclient-services": [
            "Oauth2"
        ]
    },
    "scripts": {
        "pre-autoload-dump": "Google\\Task\\Composer::cleanup"
    }
}
