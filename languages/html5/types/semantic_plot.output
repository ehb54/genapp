// -- semantic_plot.output --

ga.layout.fields[ "__fields:id__" ] = {};
ga.layout.fields[ "__fields:id__" ].lhtml =
  '<label for="__fields:id__" class="ga-g-__moduleid__-__fields:id____~fields:help{ help_link}" style="__~fields:labelmargin{margin:__fields:labelmargin__;}__~fields:labelmargintop{margin-top:__fields:labelmargintop__;}">__fields:label__ </label>'
  __~fields:help{+ '<span class="help">__fields:help__</span>'}
  ;
ga.layout.fields[ "__fields:id__" ].dhtml =
  '<div name="__fields:id__" class="ga-g-__moduleid__-__fields:id__" id="__fields:id__" type="semantic_plot"></div>'
  ;

ga.layout.fields[ "__fields:id__" ].eval =
  'ga.value.setLastValue( "__moduleid___output", "#__fields:id__" );'
  + 'ga.value.extra_resets( "__fields:id__" );__~hoverhighlight{$(".ga-g-__moduleid__-__fields:id__").hover(function(){$(".ga-g-__moduleid__-__fields:id__").toggleClass("ga-highlight")});}'
  ;

// -- end semantic_plot.output --
