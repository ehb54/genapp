// -- integerpair.input --

ga.layout.fields[ "__fields:id__" ] = {};
ga.layout.fields[ "__fields:id__" ].lhtml = '<label for="__fields:id__" class="ga-g-__moduleid__-__fields:id__" style="__~fields:labelmargin{margin:__fields:labelmargin__;}__~fields:labelmargintop{margin-top:__fields:labelmargintop__;margin-bottom:0;}"__~fields:hidden{ hidden}>__fields:label__ </label>';
ga.layout.fields[ "__fields:id__" ].dhtml = '<input type="text" name="__fields:id__" id="__fields:id__"__~fields:default{ value="__fields:default__"}__~fields:required{ required} pattern="[0-9]+,[0-9]+" oninput="this.reportValidity() ? this.style.color=`` : this.style.color=`red`" __~fields:maxlength{ maxlength="__fields:maxlength__"}__~fields:size{ size="__fields:size__"}__~fields:readonly{ readonly} class="ga-g-__moduleid__-__fields:id__ ga-field-input-control__~fields:help{ help_link}"__~fields:hidden{ hidden}><span class="help">__fields:help__</span}><span id="__fields:id___msg" class="warning field_msg" > </span>';
__~fields:repeater{ga.layout.fields[ "__fields:id__" ].rhtml = ga.layout.rhtml( '__fields:id__' );}
__~fields:repeat{ga.layout.slayout( '__fields:id__' );}

ga.layout.fields[ "__fields:id__" ].eval  =
  __~fields:pull{'ga.pull.toPull( "__moduleid__", "#__fields:id__", "text", "__fields:pull__", "#__fields:repeat__" );' + }
  __~fields:repeater{'ga.repeat.repeater( "__moduleid__", "__fields:id__", "integerpair", "__fields:tableize__" );$( "#__fields:id__" ).change( function() { ga.repeat.change( "__moduleid__", "__fields:id__" ); } );' + }
  __~fields:safefile{ '$( "#__fields:id__" ).blur( function() { ga.valid.safeFile( "#__fields:id__" ); } );' + }
  __~fields:calc{'ga.calc.register( "__moduleid__", "__fields:id__", "__fields:calc__" );' + }
  __~fields:repeater{'ga.repeat.change( "__moduleid__", "__fields:id__" );' +}
  __~fields:globuslogin{'$("#userid").val( username_globus );' +}
  __~fields:googlelogin{'$("#userid").val( username_google );' +}
  'ga.value.registerid("__moduleid__","__fields:id__","__fields:label__"__~fields:required{,"text"});'
  + '$( "#__fields:id__" ).blur( function() { ga.valid.checkText( "#__fields:id__" ); });'
  + __~fields:specifiedproject{'ga.specproj( "__fields:specifiedproject__", "#__fields:id__" );' +}
  'ga.value.setLastValue( "__moduleid__", "#__fields:id__" );$( "#__fields:id__" ).keypress( function() { $( "#__fields:id___msg" ).html( "" ); });__~hoverhighlight{$(".ga-g-__moduleid__-__fields:id__").hover(function(){$(".ga-g-__moduleid__-__fields:id__").toggleClass("ga-highlight")});}'
;

__~fields:repeat{[ ga.layout.fields[ "__fields:id__" ].lhtml, ga.layout.fields[ "__fields:id__" ].dhtml ] = ga.repeat.repeat( "__moduleid__", "__fields:id__" );}
__~fields:repeat{ga.layout.fields[ "__fields:id__" ].eval = 'ga.repeat.repeatOn("__moduleid__", "__fields:id__", "__fields:repeat__" );';}
__~fields:repeater{ input_repeats += 'ga.repeat.change( "__moduleid__", "__fields:id__", 1 );'};
