// -- action.input --

ga.layout.fields[ "__fields:id__" ] = {};
ga.layout.fields[ "__fields:id__" ].lhtml = '<label class="__~fields:default{__fields:default__ }__~fields:fontclass{__fields:fontclass__ }__~fields:help{help_link}__~fields:hidden{ hidden}">__~fields:label{__fields:label__}</label>';
ga.layout.fields[ "__fields:id__" ].lhtml += '__~fields:help{<span class="help">__fields:help__</span>}';
ga.layout.fields[ "__fields:id__" ].dhtml =
'<button type="button" id="__moduleid_____fields:id___action"__~fields:margin{ style="margin:__fields:margin__"}__~fields:buttonstyle{ class="ga-button-__fields:buttonstyle__"}'
+ '__~fields:disabled{ disabled}'
+ '__!fields:buttonstyle{ class="ga-button-select"}'
+ ` onclick='ga.action.click("__moduleid__","__fields:id__","__fields:actiondata__")'`
+ `__~fields:hidden{ hidden}>`
+ '<span class="buttontext">__fields:buttontext__</span></button><div id="__fields:id___actionval"__~fields:help{ class="help_link"}></div>';
ga.layout.fields[ "__fields:id__" ].dhtml += '__~fields:help{<span class="help">__fields:help__</span>}';

__~fields:repeat{ga.layout.slayout( '__fields:id__' );}
ga.layout.fields[ "__fields:id__" ].eval = '';

__~fields:repeat{[ ga.layout.fields[ "__fields:id__" ].lhtml, ga.layout.fields[ "__fields:id__" ].dhtml ] = ga.repeat.repeat( "__moduleid__", "__fields:id__" );}
__~fields:repeat{ga.layout.fields[ "__fields:id__" ].eval = 'ga.repeat.repeatOn("__moduleid__", "__fields:id__", "__fields:repeat__" );';}

