{
    "moduleid"   : "workbench_layout",
    "label"      : "Workbench Layout",
    "executable" : "plain",
    "resource"   : "local",
    "fields"     : [
        {
            "role"    : "input",
            "id"      : "input_value",
            "label"   : "Input value",
            "type"    : "text",
            "default" : "neutral fixture"
        },
        {
            "role"    : "input",
            "id"      : "show_workflow_cards",
            "label"   : "Show workflow choices",
            "type"    : "checkbox",
            "checked" : "true",
            "repeater" : "true"
        },
        {
            "role"    : "input",
            "id"      : "include_primary_data",
            "label"   : "Include primary data",
            "type"    : "checkbox",
            "checked" : "false",
            "repeater" : "true"
        },
        {
            "role"    : "input",
            "id"      : "include_secondary_data",
            "label"   : "Include secondary data",
            "type"    : "checkbox",
            "checked" : "false",
            "repeater" : "true"
        },
        {
            "role"    : "input",
            "id"      : "workflow_choice",
            "label"   : "Choose a workflow",
            "type"    : "listbox",
            "values"  : "Prepare data~prepare~Inspect data~inspect",
            "default" : "prepare",
            "repeat"  : "show_workflow_cards",
            "repeater" : "true"
        },
        {
            "role"    : "input",
            "id"      : "preparation_note",
            "label"   : "Preparation note",
            "type"    : "text",
            "default" : "visible from the declared workflow default",
            "repeat"  : "workflow_choice:prepare"
        },
        {
            "role"     : "input",
            "id"       : "sample_count",
            "label"    : "Number of samples",
            "type"     : "integer",
            "default"  : 2,
            "tableize" : "true",
            "repeater" : "true"
        },
        {
            "role"    : "input",
            "id"      : "sample_fraction",
            "label"   : "Sample fraction",
            "type"    : "text",
            "default" : ["0.85", "1.00"],
            "repeat"  : "sample_count"
        },
        {
            "role"     : "input",
            "id"       : "input_file",
            "label"    : "Input file",
            "type"     : "lrfile",
            "required" : "true",
            "repeat"   : "sample_count"
        },
        {
            "role"    : "input",
            "id"      : "sample_concentration",
            "label"   : "Sample concentration",
            "type"    : "text",
            "default" : ["7.7", "7.7"],
            "repeat"  : "sample_count"
        },
        {
            "role"  : "output",
            "id"    : "primary_plot",
            "label" : "Primary plot",
            "type"  : "plotly"
        },
        {
            "role"  : "output",
            "id"    : "structure_view",
            "label" : "Structure view",
            "type"  : "ngl"
        },
        {
            "role"  : "output",
            "id"    : "wide_plot",
            "label" : "Wide plot",
            "type"  : "plotly"
        },
        {
            "role"          : "output",
            "id"            : "dynamic_gallery",
            "label"         : "Dynamic gallery",
            "type"          : "plotly",
            "dynamicoutput" : "true",
            "idprefix"      : "fixture_plot",
            "max"           : "2"
        }
    ]
}
