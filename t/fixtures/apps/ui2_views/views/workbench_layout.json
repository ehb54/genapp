{
    "renderer" : "react-workbench",
    "layout"   : "scientific-workbench",
    "inputs"   : {
        "workflowChoices" : {
            "data-scope" : {
                "title" : "Choose data to prepare",
                "fields" : ["include_primary_data", "include_secondary_data"],
                "order" : ["both", "primary"],
                "choices" : {
                    "primary" : {
                        "title" : "Primary data only",
                        "description" : "Prepare the primary data set.",
                        "matches" : {"include_primary_data" : true, "include_secondary_data" : false},
                        "values" : {"include_primary_data" : true, "include_secondary_data" : false}
                    },
                    "both" : {
                        "title" : "Primary and secondary data",
                        "description" : "Prepare both data sets together.",
                        "matches" : {"include_primary_data" : true, "include_secondary_data" : true},
                        "values" : {"include_primary_data" : true, "include_secondary_data" : true}
                    }
                }
            }
        },
        "sections" : [
            {
                "id"     : "inputs",
                "title"  : "Inputs",
                "fields" : ["input_value", "show_workflow_cards", "workflow_choice"],
                "workflowChoices" : ["data-scope"]
            },
            {
                "id"        : "repeated-samples",
                "title"     : "Repeated samples",
                "layout"    : "repeated-cards",
                "itemLabel" : "Sample",
                "fields"    : ["sample_count", "sample_source", "sample_fraction", "input_file", "sample_weight", "sample_concentration"]
            },
            {
                "id"     : "ordinary-repeat",
                "title"  : "Ordinary repeat",
                "fields" : ["control_count", "control_value"]
            },
            {
                "id"     : "prepare-options",
                "title"  : "Prepare options",
                "repeat" : "workflow_choice:prepare",
                "fields" : ["preparation_note"]
            }
        ],
        "fieldPresentations" : {
            "workflow_choice" : {
                "control" : "choice-cards",
                "title" : "Choose a workflow",
                "choices" : {
                    "prepare" : {"title" : "Prepare data", "description" : "Create data ready for later work."},
                    "inspect" : {"title" : "Inspect data", "description" : "Review existing data without changing it."}
                }
            },
            "sample_source" : {
                "control" : "repeated-choice-cards",
                "choices" : {
                    "prepared" : {"title" : "Prepared data", "description" : "Use data that has already been prepared."},
                    "raw" : {"title" : "Raw data", "description" : "Use the original data."}
                }
            }
        }
    },
    "results" : {
        "groups" : [
            {
                "id"      : "primary",
                "label"   : "Primary plot",
                "outputs" : ["primary_plot"],
                "primary" : true,
                "fit"     : "pane",
                "plotPresentation" : {
                    "axisTitleOverflow" : "wrap"
                }
            },
            {
                "id"      : "structure",
                "label"   : "Structure",
                "outputs" : ["structure_view"]
            },
            {
                "id"      : "wide",
                "label"   : "Wide plot",
                "outputs" : ["wide_plot"],
                "fit"     : "wide"
            },
            {
                "id"         : "dynamic-gallery",
                "label"      : "Dynamic gallery",
                "outputs"    : ["dynamic_gallery"],
                "fit"        : "wide",
                "layout"     : "gallery",
                "visibility" : "available"
            }
        ]
    }
}
