{
    "moduleid"   : "action_demo",
    "label"      : "Action Demo",
    "executable" : "run_action_demo",
    "resource"   : "local",
    "fields"     : [
        {
            "role"    : "input",
            "id"      : "sample",
            "label"   : "Sample",
            "type"    : "text",
            "default" : "alpha"
        },
        {
            "role"    : "input",
            "id"      : "input_mode",
            "label"   : "Input mode",
            "type"    : "listbox",
            "values"  : "Paste text~c1~Upload file~c2",
            "default" : "c1",
            "repeater": "true"
        },
        {
            "role"     : "input",
            "id"       : "primary_file",
            "label"    : "Primary file",
            "type"     : "lrfile",
            "required" : "true",
            "repeat"   : "input_mode:c2"
        },
        {
            "role"     : "input",
            "id"       : "secondary_file",
            "label"    : "Secondary file",
            "type"     : "lrfile",
            "required" : "true"
        },
        {
            "role"     : "input",
            "id"       : "part_count",
            "label"    : "Part count",
            "type"     : "integer",
            "default"  : 2,
            "repeater" : "true"
        },
        {
            "role"     : "input",
            "id"       : "part_file",
            "label"    : "Part file",
            "type"     : "lrfile",
            "repeat"   : "part_count",
            "required" : "true"
        },
        {
            "role"       : "input",
            "id"         : "precheck",
            "label"      : "Input check (Å)",
            "type"       : "action",
            "buttontext" : "Precheck Å²",
            "executable" : "precheck_action",
            "resource"   : "host",
            "actiondata" : "_allformdata",
            "timeout"    : "10"
        },
        {
            "role"     : "input",
            "id"       : "show_conditional",
            "label"    : "Show conditional precheck",
            "type"     : "checkbox",
            "repeater" : "true"
        },
        {
            "role"     : "input",
            "id"       : "conditional_precheck",
            "label"    : "Conditional input check",
            "type"     : "action",
            "buttontext" : "Conditional precheck",
            "executable" : "precheck_action",
            "actiondata" : "_allformdata",
            "actionfiledata" : "primary_file",
            "repeat"   : "show_conditional"
        },
        {
            "role"       : "input",
            "id"         : "fileless_precheck",
            "label"      : "Fileless input check",
            "type"       : "action",
            "buttontext" : "Fileless precheck",
            "executable" : "precheck_action",
            "actiondata" : "sample",
            "actionfiledata" : "_none"
        },
        {
            "role"       : "input",
            "id"         : "empty_file_scope_precheck",
            "label"      : "Invalid empty file scope",
            "type"       : "action",
            "buttontext" : "Invalid empty file scope",
            "executable" : "precheck_action",
            "actiondata" : "sample",
            "actionfiledata" : ""
        },
        {
            "role"       : "input",
            "id"         : "mixed_file_scope_precheck",
            "label"      : "Invalid mixed file scope",
            "type"       : "action",
            "buttontext" : "Invalid mixed file scope",
            "executable" : "precheck_action",
            "actiondata" : "sample",
            "actionfiledata" : "_none,primary_file"
        },
        {
            "role"  : "output",
            "id"    : "precheck_summary",
            "label" : "Precheck summary",
            "type"  : "text"
        },
        {
            "role"  : "output",
            "id"    : "reply",
            "label" : "Reply",
            "type"  : "text"
        }
    ]
}
