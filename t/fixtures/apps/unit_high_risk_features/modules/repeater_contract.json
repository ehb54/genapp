{
    "moduleid"   : "repeater_contract",
    "label"      : "Repeater Contract",
    "executable" : "repeater_contract",
    "resource"   : "local",
    "fields"     : [
        {
            "role"     : "input",
            "id"       : "analysis_mode",
            "label"    : "Analysis Mode",
            "type"     : "listbox",
            "values"   : "Basic~basic~Advanced~advanced~Pair Grid~pair",
            "default"  : "basic",
            "repeater" : "true"
        },
        {
            "role"     : "input",
            "id"       : "advanced_count",
            "label"    : "Advanced Rows",
            "type"     : "integer",
            "default"  : "2",
            "min"      : "0",
            "max"      : "4",
            "repeater" : "true",
            "repeat"   : "analysis_mode:advanced"
        },
        {
            "role"    : "input",
            "id"      : "advanced_label",
            "label"   : "Advanced Label",
            "type"    : "text",
            "default" : "advanced",
            "repeat"  : "advanced_count"
        },
        {
            "role"     : "input",
            "id"       : "nested_gate",
            "label"    : "Nested Gate",
            "type"     : "checkbox",
            "repeater" : "true",
            "repeat"   : "advanced_count"
        },
        {
            "role"    : "input",
            "id"      : "nested_value",
            "label"   : "Nested Value",
            "type"    : "text",
            "default" : "nested",
            "repeat"  : "nested_gate"
        },
        {
            "role"     : "input",
            "id"       : "pair_grid",
            "label"    : "Pair Grid",
            "type"     : "integerpair",
            "default"  : "2,3",
            "repeater" : "true",
            "repeat"   : "analysis_mode:pair"
        },
        {
            "role"    : "input",
            "id"      : "pair_payload",
            "label"   : "Pair Payload",
            "type"    : "text",
            "default" : "payload",
            "repeat"  : "pair_grid"
        },
        {
            "role"    : "input",
            "id"      : "use_experimental_data",
            "label"   : "Use Experimental Data",
            "type"    : "checkbox",
            "checked" : "false"
        },
        {
            "role"    : "input",
            "id"      : "neutron_checkbox",
            "label"   : "Neutron Data",
            "type"    : "checkbox",
            "checked" : "false"
        },
        {
            "role"    : "input",
            "id"      : "xray_checkbox",
            "label"   : "X-ray Data",
            "type"    : "checkbox",
            "checked" : "false"
        },
        {
            "role"    : "input",
            "id"      : "prediction_q",
            "label"   : "Prediction Q",
            "type"    : "text",
            "default" : "0.1",
            "repeat"  : "!use_experimental_data"
        },
        {
            "role"    : "input",
            "id"      : "neutron_exp_file",
            "label"   : "Neutron Experimental File",
            "type"    : "text",
            "default" : "neutron.dat",
            "repeat"  : "use_experimental_data && neutron_checkbox"
        },
        {
            "role"    : "input",
            "id"      : "xray_exp_file",
            "label"   : "X-ray Experimental File",
            "type"    : "text",
            "default" : "xray.dat",
            "repeat"  : "use_experimental_data && xray_checkbox"
        },
        {
            "role"    : "input",
            "id"      : "checkbox_gate",
            "label"   : "Checkbox Gate",
            "type"    : "checkbox",
            "checked" : "false"
        },
        {
            "role"     : "input",
            "id"       : "checkbox_gate_count",
            "label"    : "Checkbox Gate Rows",
            "type"     : "integer",
            "default"  : "0",
            "min"      : "0",
            "max"      : "4",
            "repeater" : "true",
            "repeat"   : "checkbox_gate:true"
        },
        {
            "role"    : "input",
            "id"      : "checkbox_gate_value",
            "label"   : "Checkbox Gate Value",
            "type"    : "text",
            "default" : "gated",
            "repeat"  : "checkbox_gate_count"
        },
        {
            "role"  : "output",
            "id"    : "repeater_summary",
            "label" : "Repeater Summary",
            "type"  : "text"
        }
    ]
}
